#!/usr/bin/env bash
# Local rules — copy to scripts/docs-check.local.sh and edit.
#
# The shared guard is deliberately stack-agnostic: it knows about documents,
# not about your domain. Anything true only for THIS repo goes here, so that
# updating the shared guard never clobbers it and never drags your rules into
# somebody else's project.
#
# Available to you: err "msg" (fails the run) · warnf "msg" (warns) ·
#                   note "msg" (dim line) · scan "<extended-regex>" (searches
#                   docs/ plus root-level markdown, returns file:line:text)
#
# One gotcha: the guard runs under `set -o pipefail`, so end any pipeline you
# write with `|| true` if a no-match is a normal outcome. `scan` itself always
# succeeds, so `scan '...' | grep -q .` is safe as written.
#
# Everything below is an example. Delete what does not apply.

# --- an identifier that is public, but still identifies you -----------------
# Public in the sense that anyone can look it up; identifying in the sense that
# publishing it links this repo to you. Only you can tell the two apart, so
# this warns rather than fails.
#
# hits=$(scan '<your-pattern-here>' | cut -d: -f1 | sort -u | tr '\n' ' ')
# [ -n "$hits" ] && warnf "check these are the public ones, not yours: $hits"

# --- names that must not appear in a repo that may go public ---------------
# for name in acme-corp northwind "Project Bluebird"; do
#   scan "$name" | grep -q . && err "client name '$name' appears in a document"
# done

# --- internal hosts and private addresses ----------------------------------
# scan '([a-z0-9-]+\.internal|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})' \
#   | grep -q . && warnf "an internal hostname or private IP is in a document"

# --- a convention only your team has ---------------------------------------
# every runbook must name who tested it, because an untested runbook at 3am is
# worse than no runbook:
#
# for f in docs/runbooks/*.md; do
#   [ -e "$f" ] || continue
#   grep -qi 'tested by' "$f" || err "$f — no 'tested by' line"
# done
